{
  "name": "owl-expressjs-utils",
  "version": "1.0.1",
  "description": "TypeScript utilities for building Express.js applications with MongoDB, Mongoose, sessions, authentication, CORS, encryption, and CRUD controllers.",
  "type": "module",
  "author": {
    "name": "KaguilarA",
    "email": "kevin.231@hotmail.com",
    "url": "https://github.com/KaguilarA"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "build-demo": "tsc -p tsconfig.demo.json && vite build --config vite.demo.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "preview-demo": "vite preview --config vite.demo.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaguilarA/owl-expressjs-utils.git"
  },
  "homepage": "https://github.com/KaguilarA/owl-expressjs-utils#readme",
  "keywords": [
    "express",
    "expressjs",
    "mongoose",
    "mongodb",
    "typescript",
    "cors",
    "session",
    "authentication",
    "encryption",
    "crud"
  ],
  "dependencies": {
    "bcryptjs": "3.0.3",
    "connect-mongo": "6.0.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "mongoose": "8.12.0"
  },
  "devDependencies": {
    "@types/express-session": "1.19.0",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "jsdom": "26.1.0",
    "typescript": "~5.8.3",
    "vite": "7.1.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  }
}
